[api]
base_url =
api_key =

[translation]
model = qwen-mt-flash
target_lang = Chinese
domain = Postgraduate Computer Science–AI coursework. Preserve standard terminology in AI, machine learning, probability and statistics, linear algebra, optimization, and software engineering.
; Optional per-lecture hint, for example: Regularisation & Bias-variance Trade-off — Statistical Machine Learning
course_topic =
; Optional reusable profile id from course_profiles/, selected in the Dashboard.
; Profile display names are generic (not local university codes). A cloned
; installation starts with no profile and no personal terminology.
course_profile =
threads = 4
ai_deadline_seconds = 3.0
fast_backend = apple
provider = Alibaba Cloud Qwen-MT
workflow = single_model
bridge_provider = off
# Smart Hybrid only: gemini, or the Groq → Cerebras final pool.
smart_hybrid_final_provider = gemini
single_provider = Alibaba Cloud Qwen-MT
# auto: try live preview once, then remember if the endpoint only supports non-streaming.
single_streaming_mode = auto
# Optional per-course files. Empty by default so cloned installations do not
# inherit the maintainer's degree-specific terminology or ASR corrections.
glossary_path =
asr_corrections_path =

[providers]
deepseek_api_key =
siliconflow_api_key =
qwen_mt_api_key =
qwen_mt_base_url =
groq_api_key =
cerebras_api_key =
gemini_api_key =
cloudflare_account_id =
cloudflare_api_token =

[smart_hint]
# Optional low-priority lecture context helper. It reads only finalized English
# every four minutes and never waits for or changes the live translation route.
enabled = false
provider = siliconflow
api_key =
base_url = https://api.siliconflow.cn/v1
model = deepseek-ai/DeepSeek-V4-Flash
interval_seconds = 240

[display]
display_duration = 10
window_width = 800
window_height = 120
mode = notch
# Subtitle stability only controls what is drawn. It never delays ASR,
# Apple Translation, remote translation, or transcript persistence.
# realtime / balanced / stable
subtitle_presentation_policy = realtime
# Coalesce only continuous remote AI updates. First English, Apple drafts and
# final translations are always rendered immediately. fluent / steady / focus
subtitle_update_pacing = fluent
# Control-center background transparency. 0 is fully opaque; maximum is 70.
# Restart the app after changing this value.
control_center_transparency = 30

[shortcut]
enabled = true
double_tap_interval = 0.45

[diagnostics]
# Enable temporarily only while troubleshooting; restart after changing it.
enabled = false

[usage]
# Optional session Token/cost meter. Provider quota routing is always active.
tracking_enabled = true

[records]
# Save one timestamped bilingual transcript per translation session.
# Files are stored permanently in ~/Documents/Anotime Records.
auto_save_transcripts = true

[pipeline]
# Isolate ASR/Apple UI updates from finalized remote translation work.
split_fast_path = true

[transcription]
backend = apple
; apple (recommended) / parakeet_eou (experimental English-only) / mlx
; whisper and funasr remain developer-only optional backends and are not shown in the app.
whisper_model = base
funasr_model = iic/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
device = auto
compute_type = float16
source_language = en
; Disabled by default. When enabled, raises only weak non-silent audio before
; it reaches experimental Parakeet EOU; it never changes Apple/MLX input.
parakeet_adaptive_gain = false
transcription_workers = 4

[audio]
; auto / numeric microphone index / system (macOS ScreenCaptureKit app audio)
device_index = auto
sample_rate = 16000
silence_threshold = 0.005
silence_duration = 0.5
chunk_duration = 0.1
max_phrase_duration = 30
streaming_mode = true
streaming_interval = 3
streaming_step_size = 0.05
update_interval = 0.5
streaming_overlap = 0.3
; Stable Prefix is observational: Apple still translates every new partial immediately.
stable_prefix_window = 0.25
stable_prefix_min_words = 3
