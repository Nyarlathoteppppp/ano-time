[api]
base_url = http://localhost:11434/v1/
api_key = your-api-key

[translation]
model = qwen2.5:7b
target_lang = Chinese
domain = Postgraduate computer science coursework with computer science and mathematics terminology.
threads = 4
fast_backend = apple
provider = Custom

[providers]
deepseek_api_key =
siliconflow_api_key =
qwen_mt_api_key =
qwen_mt_base_url =

[display]
display_duration = 10
window_width = 800
window_height = 120
mode = glass

[transcription]
backend = whisper
whisper_model = base
funasr_model = iic/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
device = auto
compute_type = float16
source_language = auto
transcription_workers = 4

[audio]
device_index = auto
sample_rate = 16000
silence_threshold = 0.005
silence_duration = 0.5
chunk_duration = 0.1
max_phrase_duration = 30
streaming_mode = true
streaming_interval = 3
streaming_step_size = 0.2
update_interval = 0.8
streaming_overlap = 0.3
